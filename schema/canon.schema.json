{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lit-spec.org/schema/canon.schema.json",
  "title": "LIT canon manifest",
  "description": "Explicit story-world facts, constraints, disagreements, and ambiguities.",
  "type": "object",
  "required": [
    "litVersion",
    "project",
    "assertions"
  ],
  "properties": {
    "litVersion": {
      "$ref": "#/$defs/version"
    },
    "project": {
      "type": "string",
      "format": "uri"
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "entityId": {
      "type": "string",
      "anyOf": [
        {
          "format": "uri"
        },
        {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        }
      ]
    },
    "assertion": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "predicate",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/entityId"
        },
        "subject": {
          "$ref": "#/$defs/entityId"
        },
        "predicate": {
          "type": "string",
          "anyOf": [
            {
              "format": "uri"
            },
            {
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
            }
          ]
        },
        "object": {
          "$ref": "#/$defs/entityId"
        },
        "value": true,
        "status": {
          "enum": [
            "canonical",
            "provisional",
            "disputed",
            "retconned",
            "ambiguous"
          ]
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entityId"
          }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entityId"
          }
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date"
        },
        "effectiveUntil": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "oneOf": [
        {
          "required": [
            "object"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        },
        {
          "required": [
            "value"
          ],
          "not": {
            "required": [
              "object"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
