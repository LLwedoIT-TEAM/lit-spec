{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lit-spec.org/schema/components.schema.json",
  "title": "LIT components manifest",
  "description": "Addressable narrative units and the relationships between them.",
  "type": "object",
  "required": [
    "litVersion",
    "project",
    "components"
  ],
  "properties": {
    "litVersion": {
      "$ref": "#/$defs/version"
    },
    "project": {
      "type": "string",
      "format": "uri"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "entityId": {
      "type": "string",
      "anyOf": [
        {
          "format": "uri"
        },
        {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        }
      ]
    },
    "content": {
      "type": "object",
      "required": [
        "mediaType"
      ],
      "properties": {
        "mediaType": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "inline": {
          "type": "string"
        },
        "href": {
          "type": "string",
          "format": "uri-reference",
          "minLength": 1
        },
        "encoding": {
          "enum": [
            "utf-8",
            "base64"
          ]
        },
        "integrity": {
          "type": "string",
          "pattern": "^(sha256|sha384|sha512)-[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "oneOf": [
        {
          "required": [
            "inline"
          ],
          "not": {
            "required": [
              "href"
            ]
          }
        },
        {
          "required": [
            "href"
          ],
          "not": {
            "required": [
              "inline"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "content"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/entityId"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "contributors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entityId"
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "source",
        "target",
        "type"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/entityId"
        },
        "target": {
          "$ref": "#/$defs/entityId"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "label": {
          "type": "string"
        },
        "condition": {
          "type": "string",
          "description": "An inert, human-readable condition; never executable code."
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
