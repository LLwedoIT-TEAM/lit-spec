{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lit-spec.org/schema/project.schema.json",
  "title": "LIT project manifest",
  "description": "The entry point and descriptive metadata for a LIT bundle.",
  "type": "object",
  "required": [
    "litVersion",
    "id",
    "title",
    "type",
    "contributors",
    "components",
    "canon",
    "provenance",
    "rights"
  ],
  "properties": {
    "litVersion": {
      "$ref": "#/$defs/version"
    },
    "id": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "novel",
        "anthology",
        "collection",
        "nonlinear-fiction",
        "poetry",
        "drama",
        "screenplay",
        "memoir",
        "nonfiction",
        "hybrid",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contributor"
      }
    },
    "identifiers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "modified": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "$ref": "#/$defs/manifestReference"
    },
    "canon": {
      "$ref": "#/$defs/manifestReference"
    },
    "provenance": {
      "$ref": "#/$defs/manifestReference"
    },
    "rights": {
      "$ref": "#/$defs/manifestReference"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "entityId": {
      "type": "string",
      "anyOf": [
        {
          "format": "uri"
        },
        {
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        }
      ]
    },
    "manifestReference": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1
    },
    "contributor": {
      "type": "object",
      "required": [
        "id",
        "name",
        "roles"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/entityId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
          }
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
